      "item": [
        {
          "name": "Crear Autoridad",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta correcta\", () => pm.expect(pm.response.text()).to.include(\"creada\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"García\",\n  \"dni\": 30123456,\n  \"genero\": \"M\",\n  \"idPlaca\": 1001,\n  \"idLegajo\": 2001\n}"
            },
